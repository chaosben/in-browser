{
	"lang": "de",
	"id": "/fonts",
	"name": "Schriften – in-browser",
	"short_name": "Schriften",
	"description": "Deine eigenen Schriften für jedes Tool von in-browser – aus deinen Dateien oder aus dem Katalog.",
	"start_url": "/fonts",
	"scope": "/fonts",
	"display": "standalone",
	"launch_handler": {
		"client_mode": "focus-existing"
	},
	"categories": [
		"productivity",
		"utilities",
		"design"
	],
	"background_color": "#1c1f25",
	"theme_color": "#1c1f25",
	"icons": [
		{
			"src": "/fonts/favicon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		},
		{
			"src": "/fonts/icon-maskable.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "maskable"
		}
	]
}

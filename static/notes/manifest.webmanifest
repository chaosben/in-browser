{
	"id": "/notes",
	"name": "Notes – in-browser",
	"short_name": "Notes",
	"description": "Handwritten notes with pen, highlighter and eraser – made for stylus and touch, entirely in the browser.",
	"start_url": "/notes",
	"scope": "/notes",
	"display": "standalone",
	"launch_handler": { "client_mode": "focus-existing" },
	"categories": ["productivity", "education"],
	"background_color": "#1c1f25",
	"theme_color": "#1c1f25",
	"icons": [
		{ "src": "/notes/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
		{ "src": "/notes/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
	]
}

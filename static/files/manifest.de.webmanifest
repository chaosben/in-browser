{
	"lang": "de",
	"id": "/files",
	"name": "Dateien – in-browser",
	"short_name": "Dateien",
	"description": "Verwalte die Dateien deiner in-browser-Tools und gleiche sie mit einem Ordner auf deinem Rechner ab.",
	"start_url": "/files",
	"scope": "/files",
	"display": "standalone",
	"launch_handler": { "client_mode": "focus-existing" },
	"categories": ["productivity", "utilities"],
	"background_color": "#1c1f25",
	"theme_color": "#1c1f25",
	"icons": [
		{ "src": "/files/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
		{ "src": "/files/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
	]
}

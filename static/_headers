# Header rules for Cloudflare Workers Static Assets (copied to build/).
# Rules apply in this order; a tool section first unsets (`! Header`) what it sets differently.

# File names contain a hash – cache permanently
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Overview (and the defaults of every path)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), display-capture=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Build files: a worker runs under the policy of its own script. PDF.js (Notes) decodes images in its workers with
# WebAssembly, so scripts may compile it; pages keep their own policies below
/_app/immutable/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Screen Capture: screen, microphone and camera; media and workers from blob:
/screen-capture*
  ! Permissions-Policy
  ! Content-Security-Policy
  Permissions-Policy: display-capture=(self), microphone=(self), camera=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob: data: wss:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Files: previews and downloads from blob:
/files*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob: data: wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Text Editor: the defaults; the Markdown preview is a sandboxed srcdoc frame with its own CSP (needs no frame-src),
# downloads are blob: links
/text-editor*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Notes: drawing; imported PDFs are rendered by PDF.js workers (see `/_app/immutable/*`); exports are blob: links
/notes*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# p2p-node (packages/p2p-node): the starters fetch version.json to find updates, people pipe the install scripts
# into a shell – always fresh, scripts as text
/p2p-node/*
  Cache-Control: no-cache

/p2p-node/install.sh
  Content-Type: text/plain; charset=utf-8

/p2p-node/install.ps1
  Content-Type: text/plain; charset=utf-8

# Always revalidate the Service Worker and the manifests so new versions get through
/service-worker.js
  Cache-Control: no-cache

/*/manifest.webmanifest
  Cache-Control: no-cache

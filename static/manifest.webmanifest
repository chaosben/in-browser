{
	"lang": "en",
	"id": "/",
	"name": "in-browser",
	"short_name": "in-browser",
	"description": "Tools that run entirely in your browser: no uploads, no account – your files stay on your device.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"launch_handler": { "client_mode": "focus-existing" },
	"share_target": {
		"action": "/files?share-target",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "files", "accept": ["*/*"] }] }
	},
	"file_handlers": [
		{ "action": "/pdf-editor?open-with", "accept": { "application/pdf": [".pdf"] } },
		{ "action": "/fonts?open-with", "accept": { "font/ttf": [".ttf"], "font/otf": [".otf"] } },
		{ "action": "/jwl-files?open-with", "accept": { "application/octet-stream": [".jwlibrary", ".jwlplaylist"] } },
		{
			"action": "/text-editor?open-with",
			"accept": {
				"text/plain": [".txt", ".md", ".markdown", ".json", ".jsonl", ".ndjson", ".csv", ".tsv", ".log", ".xml", ".yml", ".yaml", ".ini", ".cfg", ".conf", ".properties", ".toml", ".html", ".htm", ".css", ".js", ".mjs", ".cjs", ".jsx", ".ts", ".mts", ".cts", ".tsx", ".svelte", ".py", ".sh", ".bash", ".zsh"]
			}
		}
	],
	"categories": ["productivity", "utilities"],
	"background_color": "#1c1f25",
	"theme_color": "#1c1f25",
	"icons": [
		{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
		{ "src": "/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
	],
	"shortcuts": [
		{ "name": "Files", "url": "/files", "icons": [{ "src": "/files/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
		{ "name": "Text Editor", "url": "/text-editor", "icons": [{ "src": "/text-editor/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
		{ "name": "Screen Capture", "url": "/screen-capture", "icons": [{ "src": "/screen-capture/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
		{ "name": "PDF Editor", "url": "/pdf-editor", "icons": [{ "src": "/pdf-editor/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
		{ "name": "Fonts", "url": "/fonts", "icons": [{ "src": "/fonts/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
		{ "name": "JWL Files", "url": "/jwl-files", "icons": [{ "src": "/jwl-files/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] }
	]
}

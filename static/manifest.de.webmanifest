{
	"lang": "de",
	"id": "/",
	"name": "in-browser",
	"short_name": "in-browser",
	"description": "Tools, die komplett in deinem Browser laufen: kein Upload, kein Konto – deine Dateien bleiben auf deinem Gerät.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"launch_handler": { "client_mode": "focus-existing" },
	"categories": ["productivity", "utilities"],
	"background_color": "#1c1f25",
	"theme_color": "#1c1f25",
	"icons": [
		{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
		{ "src": "/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
	],
	"shortcuts": [
		{ "name": "Dateien", "url": "/files", "icons": [{ "src": "/files/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
		{ "name": "Notizen", "url": "/notes", "icons": [{ "src": "/notes/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
		{ "name": "Texteditor", "url": "/text-editor", "icons": [{ "src": "/text-editor/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
		{ "name": "Bildschirmaufnahme", "url": "/screen-capture", "icons": [{ "src": "/screen-capture/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
		{ "name": "PDF-Editor", "url": "/pdf-editor", "icons": [{ "src": "/pdf-editor/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] }
	]
}

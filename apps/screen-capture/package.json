{
	"name": "screen-capture",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"deploy": "npm run build && wrangler deploy",
		"deploy:check": "npm run build && wrangler deploy --dry-run",
		"preview:cf": "npm run build && wrangler dev",
		"icons": "node scripts/icons.mjs"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/caveat": "5.3.0",
		"@fontsource/inter": "5.3.0",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@fontsource/montserrat": "5.3.0",
		"@iconify-json/material-symbols-light": "1.2.97",
		"@in-browser/brand": "*",
		"@in-browser/vite": "*",
		"mediabunny": "1.62.1"
	}
}

{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "screen-capture",
	"compatibility_date": "2026-10-26",
	// Only our own subdomain, no *.workers.dev or preview URLs
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "screen-capture.in-browser.de", "custom_domain": true }],
	// Purely static SPA (no Worker code); unknown paths serve index.html
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	}
}

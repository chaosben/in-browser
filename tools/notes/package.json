{
	"name": "@in-browser/notes",
	"private": true,
	"license": "MIT",
	"type": "module",
	"description": "Notes tool of in-browser: handwritten notebooks (included as source code, routes under /notes)",
	"exports": {
		"./*.svelte": {
			"svelte": "./src/*.svelte",
			"default": "./src/*.svelte"
		},
		"./*.js": "./src/*.ts"
	},
	"imports": {
		"#lib": "./src/index.js",
		"#lib/*": "./src/*"
	},
	"dependencies": {
		"@in-browser/brand": "*",
		"@in-browser/files": "*",
		"@in-browser/graphics": "*",
		"@in-browser/ink": "*",
		"@in-browser/pdf": "*"
	}
}

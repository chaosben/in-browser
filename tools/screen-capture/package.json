{
	"name": "@in-browser/screen-capture",
	"private": true,
	"license": "MIT",
	"type": "module",
	"description": "Screen Capture tool of in-browser (included as source code, routes under /screen-capture)",
	"exports": {
		"./*.svelte": {
			"svelte": "./src/*.svelte",
			"default": "./src/*.svelte"
		},
		"./*.js": "./src/*.ts"
	},
	"imports": {
		"#lib": "./src/index.js",
		"#lib/*": "./src/*"
	},
	"dependencies": {
		"@fontsource/caveat": "5.3.0",
		"@fontsource/inter": "5.3.0",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@fontsource/montserrat": "5.3.0",
		"@in-browser/brand": "*",
		"@in-browser/files": "*",
		"@in-browser/graphics": "*",
		"gifenc": "1.0.3",
		"mediabunny": "1.66.0"
	}
}

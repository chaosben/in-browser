{
	"name": "in-browser",
	"private": true,
	"license": "MIT",
	"type": "module",
	"workspaces": [
		"packages/*",
		"tools/*"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest --run",
		"test:watch": "vitest",
		"deploy": "npm run build && wrangler deploy",
		"deploy:check": "npm run build && wrangler deploy --dry-run",
		"preview:cf": "npm run build && wrangler dev"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@in-browser/brand": "*",
		"@in-browser/files": "*",
		"@in-browser/files-app": "*",
		"@in-browser/screen-capture": "*",
		"@in-browser/text-editor": "*"
	},
	"devDependencies": {
		"@iconify-json/material-symbols-light": "^1.2.97",
		"@iconify/tailwind4": "^1.2.3",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"daisyui": "^5.7.50",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.152.0"
	},
	"allowScripts": {
		"esbuild": true,
		"workerd": true
	}
}
